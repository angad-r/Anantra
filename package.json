{
  "name": "anantra-junior-astronaut-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "ANANTRA — Junior Astronaut Mission Trainer (NASA Space Apps Challenge)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "tsc --ignoreConfig --noEmit --target es2023 --module esnext --strict --lib es2023,dom api/mentor.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^14.12.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}

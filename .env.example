# ANANTRA Environment Variables (Optional)
#
# ANANTRA runs 100% locally in your browser with ZERO environment variables or API keys.
# Only configure one of the server-side keys below in your Vercel project settings
# if you want to enable the optional Cloud AI mode on the /api/mentor serverless endpoint.
#
# NEVER expose private keys with VITE_ prefixes in client-side code.

# Optional Google Gemini API key for server-side /api/mentor.ts (Vercel Serverless)
GEMINI_API_KEY=

# Optional OpenAI API key fallback for server-side /api/mentor.ts (Vercel Serverless)
OPENAI_API_KEY=
